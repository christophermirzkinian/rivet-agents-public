{
  "name": "rivet-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rivet Agents: run your own Claude Code and Codex chats from your phone. Server, PWA and Mac bridge.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test 'bridge/test/*.test.mjs' 'readers/test/*.test.mjs' '.claude/hooks/test/*.test.mjs'",
    "setup": "node scripts/setup.mjs",
    "install-bridge": "bash scripts/install-bridge.sh",
    "chat": "node scripts/rivet-chat.mjs",
    "rivet": "node scripts/rivet.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "force-graph": "^1.52.0",
    "marked": "18.0.14",
    "pdfjs-dist": "6.3.289",
    "tsx": "4.22.4",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^22.10.2",
    "@types/web-push": "^3.6.4",
    "happy-dom": "20.10.6",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
