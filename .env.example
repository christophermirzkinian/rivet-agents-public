# Rivet Agents settings. `npm run setup` writes a real .env (mode 0600) with fresh tokens; this file only documents
# them. Never commit .env.

# The public URL your phone opens (passkeys are bound to it). https:// for anything but localhost.
RIVET_ORIGIN=http://localhost:8130

# Bearer tokens, 64 hex characters each. The board token lets scripts post cards; the bridge token lets the Mac bridge
# talk to the server; the enrolment token is a one-time sign-in link (<RIVET_ORIGIN>/#code=<token>).
RIVET_BOARD_TOKEN=
RIVET_BRIDGE_TOKEN=
RIVET_ENROLL_TOKEN=

# Web push (VAPID). Push is off unless all three are set. The subject is a mailto: or https: URL that identifies you.
RIVET_VAPID_PUBLIC_KEY=
RIVET_VAPID_PRIVATE_KEY=
RIVET_VAPID_SUBJECT=

# Where the server keeps its data (default ~/.rivet-agents/data; /data on Fly) and the port it listens on.
# RIVET_DATA_DIR=
# RIVET_PORT=8130

# Where the bridge and the CLI find the server (default http://127.0.0.1:8130).
# RIVET_URL=http://127.0.0.1:8130

# Optional: the chat a message with no Reply goes to. Empty (the default) means such a message starts a new chat.
# RIVET_MONITOR_CHAT=

# Optional: the GitHub repos (owner/name, comma-separated) the bridge may comment on when you answer a card.
# RIVET_REPOS=example-org/example-repo

# Optional: the time zone for times on the server (default: the system zone). The web app uses your phone's zone.
# RIVET_TIME_ZONE=

# Optional: extra arguments for every chat the runner starts, e.g. a model flag.
# RIVET_CLAUDE_ARGS=
# RIVET_CODEX_ARGS=
# RIVET_CHAT_TMUX_SOCKET=rivet-chat

# Optional: the server's Ops page. Each is off until set.
# RIVET_HEALTH_URLS=sample-app=https://example.com/health
# RIVET_FLY_APPS=sample-app
# RIVET_MACHINE_NAME=
# A separate clone the bridge fetches main into, to compare a deployed commit with history. Never a working checkout.
# RIVET_HISTORY_REPO=

# Optional: a merge-ready card's yes merges its PR, through plain `gh pr merge`, only for a repo in RIVET_REPOS and only
# with every required check green. Off by default: the yes is then a plain approve.
# RIVET_MERGE=on

# Optional: the readers (see readers/README.md). They run a Claude CLI, so they stay off until this is on and
# scripts/install-readers.sh has run.
# RIVET_READERS=on

# Optional: the Home page (see home-automation/README.md). Neither has a default. Prefer the Keychain to RIVET_HA_TOKEN.
# RIVET_HA_URL=
# RIVET_HA_TOKEN=

# Optional: Rivet's mind (see the README). Three folders with no default; with none set the map is empty.
# RIVET_MIND_MEMORY_DIR=
# RIVET_MIND_NOTES_DIR=
# RIVET_MIND_DECISIONS_DIR=

# Optional: the Claude Code hooks in .claude/. Each says nothing when it cannot do its job.
# RIVET_HARD_LINES=shadow         # off, shadow or deny
# RIVET_MERGE_GATE=               # the command your merges go through
# RIVET_CLAIMS=off                # turns the claims board off
# RIVET_SHARED_PATHS=             # default .claude/shared-paths.json
# RIVET_TEAM_ROOM=off             # stops chat-to-chat messages reaching the Team room
# RIVET_CHROME_CAP=2              # headless Chrome browsers per chat
# RIVET_MONITOR_JOB=              # default docs/monitor-job.md
# RIVET_MONITOR_STATE=            # default ~/.rivet-agents/monitor/state.md
# RIVET_DEFAULT_BRANCH=main
# RIVET_BIN=                      # the CLI, when it is not scripts/rivet.mjs
